{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Marketplace package manifest",
  "type": "object",
  "required": [
    "schema_version",
    "minimum_reader_schema_version",
    "package",
    "targets"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "x-ai-marketplace-introduced-in": 1,
      "x-ai-marketplace-deprecated-in": null,
      "x-ai-marketplace-removed-in": null,
      "x-ai-marketplace-replacement": null
    },
    "minimum_reader_schema_version": {
      "type": "integer",
      "minimum": 1,
      "x-ai-marketplace-introduced-in": 1,
      "x-ai-marketplace-deprecated-in": null,
      "x-ai-marketplace-removed-in": null,
      "x-ai-marketplace-replacement": null
    },
    "package": {
      "type": "object",
      "required": [
        "name",
        "type",
        "version",
        "description",
        "entrypoint"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "x-ai-marketplace-introduced-in": 1,
          "x-ai-marketplace-deprecated-in": null,
          "x-ai-marketplace-removed-in": null,
          "x-ai-marketplace-replacement": null
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "skill",
            "command",
            "mcp",
            "agent",
            "hook",
            "rule"
          ],
          "x-ai-marketplace-introduced-in": 1,
          "x-ai-marketplace-deprecated-in": null,
          "x-ai-marketplace-removed-in": null,
          "x-ai-marketplace-replacement": null
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "x-ai-marketplace-introduced-in": 1,
          "x-ai-marketplace-deprecated-in": null,
          "x-ai-marketplace-removed-in": null,
          "x-ai-marketplace-replacement": null
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "x-ai-marketplace-introduced-in": 1,
          "x-ai-marketplace-deprecated-in": null,
          "x-ai-marketplace-removed-in": null,
          "x-ai-marketplace-replacement": null
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "x-ai-marketplace-introduced-in": 1,
          "x-ai-marketplace-deprecated-in": null,
          "x-ai-marketplace-removed-in": null,
          "x-ai-marketplace-replacement": null
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1,
          "x-ai-marketplace-introduced-in": 1,
          "x-ai-marketplace-deprecated-in": null,
          "x-ai-marketplace-removed-in": null,
          "x-ai-marketplace-replacement": null
        }
      },
      "x-ai-marketplace-introduced-in": 1,
      "x-ai-marketplace-deprecated-in": null,
      "x-ai-marketplace-removed-in": null,
      "x-ai-marketplace-replacement": null
    },
    "targets": {
      "type": "object",
      "required": [
        "platforms",
        "delivery"
      ],
      "additionalProperties": true,
      "properties": {
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "codex",
              "cursor",
              "github-copilot",
              "claude"
            ]
          },
          "x-ai-marketplace-introduced-in": 1,
          "x-ai-marketplace-deprecated-in": null,
          "x-ai-marketplace-removed-in": null,
          "x-ai-marketplace-replacement": null
        },
        "delivery": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "workspace",
              "global",
              "cloud"
            ]
          },
          "x-ai-marketplace-introduced-in": 1,
          "x-ai-marketplace-deprecated-in": null,
          "x-ai-marketplace-removed-in": null,
          "x-ai-marketplace-replacement": null
        }
      },
      "x-ai-marketplace-introduced-in": 1,
      "x-ai-marketplace-deprecated-in": null,
      "x-ai-marketplace-removed-in": null,
      "x-ai-marketplace-replacement": null
    },
    "installation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "default": {
          "type": "boolean",
          "default": false,
          "x-ai-marketplace-introduced-in": 1,
          "x-ai-marketplace-deprecated-in": null,
          "x-ai-marketplace-removed-in": null,
          "x-ai-marketplace-replacement": null
        }
      },
      "x-ai-marketplace-introduced-in": 1,
      "x-ai-marketplace-deprecated-in": null,
      "x-ai-marketplace-removed-in": null,
      "x-ai-marketplace-replacement": null
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "x-ai-marketplace-introduced-in": 1,
          "x-ai-marketplace-deprecated-in": null,
          "x-ai-marketplace-removed-in": null,
          "x-ai-marketplace-replacement": null
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "x-ai-marketplace-introduced-in": 1,
          "x-ai-marketplace-deprecated-in": null,
          "x-ai-marketplace-removed-in": null,
          "x-ai-marketplace-replacement": null
        },
        "evaluation_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "x-ai-marketplace-introduced-in": 1,
          "x-ai-marketplace-deprecated-in": null,
          "x-ai-marketplace-removed-in": null,
          "x-ai-marketplace-replacement": null
        }
      },
      "x-ai-marketplace-introduced-in": 1,
      "x-ai-marketplace-deprecated-in": null,
      "x-ai-marketplace-removed-in": null,
      "x-ai-marketplace-replacement": null
    },
    "history": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "previous_revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$",
          "x-ai-marketplace-introduced-in": 1,
          "x-ai-marketplace-deprecated-in": null,
          "x-ai-marketplace-removed-in": null,
          "x-ai-marketplace-replacement": null
        },
        "migrations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "from"
            ],
            "additionalProperties": true,
            "properties": {
              "from": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": true,
                "properties": {
                  "source_id": {
                    "type": "string",
                    "minLength": 1,
                    "x-ai-marketplace-introduced-in": 1,
                    "x-ai-marketplace-deprecated-in": null,
                    "x-ai-marketplace-removed-in": null,
                    "x-ai-marketplace-replacement": null
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "x-ai-marketplace-introduced-in": 1,
                    "x-ai-marketplace-deprecated-in": null,
                    "x-ai-marketplace-removed-in": null,
                    "x-ai-marketplace-replacement": null
                  },
                  "repository": {
                    "type": "string",
                    "minLength": 1,
                    "x-ai-marketplace-introduced-in": 1,
                    "x-ai-marketplace-deprecated-in": null,
                    "x-ai-marketplace-removed-in": null,
                    "x-ai-marketplace-replacement": null
                  },
                  "branch": {
                    "type": "string",
                    "minLength": 1,
                    "x-ai-marketplace-introduced-in": 1,
                    "x-ai-marketplace-deprecated-in": null,
                    "x-ai-marketplace-removed-in": null,
                    "x-ai-marketplace-replacement": null
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "x-ai-marketplace-introduced-in": 1,
                    "x-ai-marketplace-deprecated-in": null,
                    "x-ai-marketplace-removed-in": null,
                    "x-ai-marketplace-replacement": null
                  }
                },
                "x-ai-marketplace-introduced-in": 1,
                "x-ai-marketplace-deprecated-in": null,
                "x-ai-marketplace-removed-in": null,
                "x-ai-marketplace-replacement": null
              }
            },
            "x-ai-marketplace-introduced-in": 1,
            "x-ai-marketplace-deprecated-in": null,
            "x-ai-marketplace-removed-in": null,
            "x-ai-marketplace-replacement": null
          },
          "x-ai-marketplace-introduced-in": 1,
          "x-ai-marketplace-deprecated-in": null,
          "x-ai-marketplace-removed-in": null,
          "x-ai-marketplace-replacement": null
        }
      },
      "x-ai-marketplace-introduced-in": 1,
      "x-ai-marketplace-deprecated-in": null,
      "x-ai-marketplace-removed-in": null,
      "x-ai-marketplace-replacement": null
    }
  }
}
